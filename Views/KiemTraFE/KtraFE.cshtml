
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HaTanTrang_KtraFe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #EAEDED;
        }
        .header {
            background-color: #131921;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
        }
        .header .logo {
            font-size: 24px;
            font-weight: bold;
        }
        .search-bar {
            display: flex;
            flex: 1;
            max-width: 600px;
            margin: 0 20px;
        }
        .search-bar input {
            width: 100%;
            padding: 8px;
            border: none;
            border-radius: 4px 0 0 4px;
            outline: none;
        }
        .search-bar button {
            background-color: #febd69;
            border: none;
            padding: 0 15px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
        }
        .header-right {
            display: flex;
            gap: 20px;
            align-items: center;
            font-size: 14px;
        }
        .cart {
            cursor: pointer;
        }
        .main-container {
            display: flex;
            padding: 20px;
            gap: 20px;
        }
        .sidebar {
            width: 220px;
            background: white;
            padding: 15px;
            border-radius: 4px;
            height: fit-content;
        }
        .sidebar h3 {
            font-size: 14px;
            margin-bottom: 10px;
            color: #0F1111;
        }
        .sidebar ul {
            list-style: none;
            margin-bottom: 15px;
        }
        .sidebar ul li a {
            text-decoration: none;
            color: #007185;
            font-size: 13px;
            line-height: 1.8;
        }
        .sidebar ul li a:hover {
            color: #c7511f;
            text-decoration: underline;
        }
        .sidebar p {
            font-size: 13px;
            color: #555;
            line-height: 1.6;
            cursor: pointer;
        }
        .product-section {
            flex: 1;
        }
        .product-section h2 {
            font-size: 20px;
            color: #0F1111;
            margin-bottom: 10px;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .product-card {
            background: white;
            padding: 15px;
            border-radius: 4px;
            text-align: center;
            border: 1px solid #ddd;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .product-card img {
            max-width: 100%;
            height: 150px;
            object-fit: contain;
            margin-bottom: 10px;
        }
        .product-title {
            font-size: 12px;
            color: #007185;
            text-align: left;
            margin-bottom: 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-decoration: none;
        }
        .product-title:hover {
            color: #c7511f;
            text-decoration: underline;
        }
        .rating {
            font-size: 11px;
            color: #ffa41c;
            text-align: left;
            margin-bottom: 8px;
        }
        .rating span {
            color: #007185;
            margin-left: 5px;
        }
        .price {
            font-size: 16px;
            font-weight: bold;
            text-align: left;
            margin-bottom: 10px;
            color: #0F1111;
        }
        .price span {
            font-size: 10px;
            vertical-align: super;
        }
        .product-card button {
            background-color: #ffd814;
            border: 1px solid #fcd200;
            width: 100%;
            padding: 8px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
        }
        .product-card button:hover {
             background-color: #f7ca00;
        }
        .extra-section {
            background: white;
            margin: 20px;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .section-header h3 {
             font-size: 18px;
             color: #0F1111;
        }

        .section-header span {
            font-size: 12px;
            color: #565959;
        }

        .horizontal-scroll {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 10px;
        }
        .horizontal-scroll .product-card {
            min-width: 170px;
            flex: 0 0 auto;
        }
        .footer {
            background-color: #232f3e;
            color: white;
            padding: 40px 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 30px;
            font-size: 12px;
        }
        .footer-col h4 {
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: bold;
        }
        .footer-col p {
            color: #dddddd;
            line-height: 1.4;
            margin-bottom: 15px;
        }
    </style>
</head>
